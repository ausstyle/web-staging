  "semantic_checks_required": [
    "Resolve account/resource ownership from real gateway actor, not input IDs",
    "Validate ISO currency, same-currency comparisons, chronological periods and unexpired approvals",
    "Verify receipt provenance and resource/source-version bindings before treating evidence as observed",
    "Reserve budget atomically in existing canonical quota ledger; estimates are not approved limits",
    "A created backup is not a tested restore; production cutover and deletion require separate authorization"
  ]
